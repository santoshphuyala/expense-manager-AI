{
  "name": "Expense Tracker Pro - Complete Suite",
  "short_name": "ExpenseTracker",
  "description": "Complete expense tracking and financial management PWA with AI insights, receipt scanning, subscriptions, wishlist, and documents management",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#667eea",
  "theme_color": "#6366f1",
  "orientation": "portrait-primary",
  "icons": [
    /* Best practice PWA icons, using your 'android-chrome' files */
    {
      "src": "icons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    /* Icon used by iOS/Safari when 'Add to Home Screen' is used */
    {
      "src": "icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    /* Favicon sizes, helpful for smaller contexts */
    {
      "src": "icons/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "icons/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    }
    /* Note: favicon.ico is typically linked directly in the HTML <head> and not usually listed in the manifest */
  ],
  "categories": ["finance", "productivity", "utilities"],
  "screenshots": [
    {
      "src": "screenshots/dashboard.png",
      "sizes": "1280x720",
      "type": "image/png"
    },
    {
      "src": "screenshots/analytics.png",
      "sizes": "1280x720",
      "type": "image/png"
    }
  ]
}